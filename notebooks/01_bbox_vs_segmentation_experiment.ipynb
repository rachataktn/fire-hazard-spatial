        "            pairs.append({'image_id':image,'object_A_class':a['class_name'],'object_A_id':a['object_id'],'object_B_class':b['class_name'],'object_B_id':b['object_id'],'bbox_A_x':a['bbox_center_x'],'bbox_A_y':a['bbox_center_y'],'bbox_A_depth':a['depth_bbox_central60_median'],'bbox_B_x':b['bbox_center_x'],'bbox_B_y':b['bbox_center_y'],'bbox_B_depth':b['depth_bbox_central60_median'],'bbox_2d_distance':bd,'bbox_depth_difference':abs(a['depth_bbox_central60_median']-b['depth_bbox_central60_median']),'bbox_edge_distance':edge_distance((a['bbox_x1'],a['bbox_y1'],a['bbox_x2'],a['bbox_y2']),(b['bbox_x1'],b['bbox_y1'],b['bbox_x2'],b['bbox_y2'])),'mask_A_x':a['mask_centroid_x'],'mask_A_y':a['mask_centroid_y'],'mask_A_depth':a['depth_mask_median'],'mask_B_x':b['mask_centroid_x'],'mask_B_y':b['mask_centroid_y'],'mask_B_depth':b['depth_mask_median'],'mask_2d_distance':md,'mask_depth_difference':abs(a['depth_mask_median']-b['depth_mask_median']),'mask_min_pixel_distance':np.nan,'delta_2d_distance':bd-md,'delta_depth_difference':abs(a['depth_bbox_central60_median']-b['depth_bbox_central60_median'])-abs(a['depth_mask_median']-b['depth_mask_median']),'depth_unit':DEPTH_UNIT})\n",
