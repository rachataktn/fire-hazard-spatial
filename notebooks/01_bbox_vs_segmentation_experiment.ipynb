{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# BBox vs Segmentation Spatial-Grounding Experiment\n",
        "Controlled Colab experiment comparing YOLO26 bounding boxes and YOLO26 instance masks with the same YOLO26-Depth map per image. This notebook does not add VLM risk reasoning."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 0. Configuration"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "DETECTION_DATASET_ROOT = '/content/drive/MyDrive/fire_hazard_dataset/Fire Hazard YOLO26 Detection'\n",
        "SEGMENTATION_DATASET_ROOT = '/content/drive/MyDrive/fire_hazard_dataset/Fire Hazard YOLO26 Segmentation Clean'\n",
        "OUTPUT_ROOT = '/content/drive/MyDrive/fire_hazard_experiment_outputs/bbox_vs_segmentation_experiment'\n",
        "\n",
        "DETECTION_DATA_YAML = f'{DETECTION_DATASET_ROOT}/data.yaml'\n",
        "SEGMENTATION_DATA_YAML = f'{SEGMENTATION_DATASET_ROOT}/data.yaml'\n",
        "\n",
        "SEED = 42\n",
        "IMGSZ = 640\n",
        "EPOCHS = 75\n",
        "BATCH = 8\n",
        "PATIENCE = 20\n",
        "CONF_THRESHOLD = 0.25\n",
        "MATCH_IOU_THRESHOLD = 0.30\n",
        "EROSION_KERNEL = 3\n",
        "\n",
        "DETECTION_MODEL = 'yolo26n.pt'\n",
        "SEGMENTATION_MODEL = 'yolo26n-seg.pt'\n",
        "DEPTH_MODEL = 'yolo26n-depth.pt'\n",
        "DEPTH_TYPE = 'requires verification'\n",
        "DEPTH_UNIT = 'relative'\n",
        "\n",
        "RUN_TRAINING = True\n",
        "RUN_SMOKE_TEST = True\n",
        "print('Configured output root:', OUTPUT_ROOT)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 1. Environment Confirmation"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import drive\n",
        "from pathlib import Path\n",
        "import json, math, os, platform, random, shutil, subprocess, sys\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "REPO_ROOT = Path('/content/fire-hazard-spatial')\n",
        "if not REPO_ROOT.exists():\n",
        "    subprocess.run(['git', 'clone', 'https://github.com/rachataktn/fire-hazard-spatial.git', str(REPO_ROOT)], check=True)\n",
        "%cd /content/fire-hazard-spatial\n",
        "\n",
        "import torch\n",
        "print('Python:', sys.version)\n",
        "print('OS:', platform.platform())\n",
        "print('PyTorch:', torch.__version__)\n",
        "print('CUDA available:', torch.cuda.is_available())\n",
        "if not torch.cuda.is_available():\n",
        "    raise RuntimeError('GPU is required. Use Runtime -> Change runtime type -> GPU.')\n",
        "print('GPU:', torch.cuda.get_device_name(0))\n",
        "\n",
        "packages = ['ultralytics', 'numpy', 'pandas', 'matplotlib', 'Pillow', 'PyYAML', 'opencv-python-headless', 'scipy', 'scikit-learn']\n",
        "subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', *packages])\n",
        "Path(OUTPUT_ROOT).mkdir(parents=True, exist_ok=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 2. Dataset Summary"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "for root, yaml_path, mode in [(DETECTION_DATASET_ROOT, DETECTION_DATA_YAML, 'detection'), (SEGMENTATION_DATASET_ROOT, SEGMENTATION_DATA_YAML, 'segmentation')]:\n",
        "    cmd = [sys.executable, 'scripts/check_dataset.py', '--dataset-root', root, '--data-yaml', yaml_path, '--task-mode', mode, '--expected-images', '23']\n",
        "    result = subprocess.run(cmd, text=True, capture_output=True)\n",
        "    print('\\n' + '=' * 70)\n",
        "    print(mode.upper())\n",
        "    print('=' * 70)\n",
        "    print(result.stdout)\n",
        "    if result.returncode != 0:\n",
        "        print(result.stderr)\n",
        "        raise RuntimeError(f'{mode} dataset validation failed')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 3. Helper Functions"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import cv2, yaml\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "from ultralytics import YOLO\n",
        "\n",
        "IMAGE_EXTS = {'.jpg', '.jpeg', '.png', '.bmp', '.webp', '.tif', '.tiff'}\n",
        "OUT = Path(OUTPUT_ROOT)\n",
        "for sub in ['detection','segmentation','depth','fused','comparisons','figures','tables']:\n",
        "    (OUT / sub).mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "def list_images(root, split='valid'):\n",
        "    p = Path(root) / split / 'images'\n",
        "    if not p.exists() and split == 'valid': p = Path(root) / 'val' / 'images'\n",
        "    return sorted([x for x in p.rglob('*') if x.suffix.lower() in IMAGE_EXTS])\n",
        "\n",
        "def image_id(path): return Path(path).stem\n",
        "\n",
        "def load_names(data_yaml):\n",
        "    y = yaml.safe_load(Path(data_yaml).read_text()) or {}\n",
        "    names = y.get('names', {})\n",
        "    return {i: str(v) for i, v in enumerate(names)} if isinstance(names, list) else {int(k): str(v) for k, v in names.items()}\n",
        "\n",
        "def extract_depth_array(result):\n",
        "    for attr in ['depth','depths','pred_depth','maps']:\n",
        "        if hasattr(result, attr):\n",
        "            v = getattr(result, attr)\n",
        "            if v is None: continue\n",
        "            if hasattr(v, 'data') and not isinstance(v, np.ndarray): v = v.data\n",
        "            if hasattr(v, 'detach'): v = v.detach().cpu().numpy()\n",
        "            arr = np.asarray(v).squeeze()\n",
        "            if arr.ndim >= 2: return arr\n",
        "    raise RuntimeError('No raw numerical depth map found on YOLO26-Depth result object.')\n",
        "\n",
        "def resize_depth(depth, h, w):\n",
        "    depth = np.asarray(depth).squeeze()\n",
        "    return depth if depth.shape[:2] == (h, w) else cv2.resize(depth.astype(np.float32), (w, h), interpolation=cv2.INTER_LINEAR)\n",
        "\n",
        "def safe_stats(values):\n",
        "    values = np.asarray(values, dtype=float)\n",
        "    valid = values[np.isfinite(values)]\n",
        "    if valid.size == 0:\n",
        "        return dict(median=np.nan, mean=np.nan, std=np.nan, min=np.nan, max=np.nan, valid_ratio=0, pixel_count=0)\n",
        "    return dict(median=float(np.median(valid)), mean=float(np.mean(valid)), std=float(np.std(valid)), min=float(np.min(valid)), max=float(np.max(valid)), valid_ratio=float(valid.size / values.size), pixel_count=int(valid.size))\n",
        "\n",
        "def box_iou(a,b):\n",
        "    ax1,ay1,ax2,ay2=a; bx1,by1,bx2,by2=b\n",
        "    ix1,iy1=max(ax1,bx1),max(ay1,by1); ix2,iy2=min(ax2,bx2),min(ay2,by2)\n",
        "    inter=max(0,ix2-ix1)*max(0,iy2-iy1)\n",
        "    area=(ax2-ax1)*(ay2-ay1)+(bx2-bx1)*(by2-by1)-inter\n",
        "    return float(inter/area) if area>0 else 0\n",
        "\n",
        "def edge_distance(a,b):\n",
        "    ax1,ay1,ax2,ay2=a; bx1,by1,bx2,by2=b\n",
        "    dx=max(bx1-ax2, ax1-bx2, 0); dy=max(by1-ay2, ay1-by2, 0)\n",
        "    return float(math.hypot(dx,dy))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 4. Mandatory One-Image Smoke Test"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if RUN_SMOKE_TEST:\n",
        "    img = list_images(DETECTION_DATASET_ROOT)[0]\n",
        "    det_result = YOLO(DETECTION_MODEL).predict(str(img), imgsz=IMGSZ, conf=CONF_THRESHOLD, verbose=False)[0]\n",
        "    if det_result.boxes is None: raise RuntimeError('Detection smoke test failed: boxes not readable')\n",
        "    seg_result = YOLO(SEGMENTATION_MODEL).predict(str(img), imgsz=IMGSZ, conf=CONF_THRESHOLD, verbose=False)[0]\n",
        "    if getattr(seg_result, 'masks', None) is None: raise RuntimeError('Segmentation smoke test failed: masks not readable')\n",
        "    depth_result = YOLO(DEPTH_MODEL).predict(str(img), imgsz=IMGSZ, verbose=False)[0]\n",
        "    depth = extract_depth_array(depth_result)\n",
        "    np.save(OUT / 'depth' / 'smoke_test_depth.npy', depth)\n",
        "    smoke = {'image': str(img), 'boxes_readable': True, 'masks_readable': True, 'raw_depth_accessible': True, 'depth_shape': list(depth.shape), 'depth_type': DEPTH_TYPE, 'depth_unit': DEPTH_UNIT}\n",
        "    (OUT / 'tables' / 'smoke_test.json').write_text(json.dumps(smoke, indent=2))\n",
        "    print(json.dumps(smoke, indent=2))\n",
        "else:\n",
        "    raise RuntimeError('Smoke test must be enabled before training')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 5. YOLO26 Detection Training"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if RUN_TRAINING:\n",
        "    det_model = YOLO(DETECTION_MODEL)\n",
        "    det_model.train(data=DETECTION_DATA_YAML, imgsz=IMGSZ, epochs=EPOCHS, seed=SEED, batch=BATCH, patience=PATIENCE, pretrained=True, project=str(OUT/'detection'), name='train', exist_ok=True, task='detect')\n",
        "DETECTION_BEST = OUT / 'detection' / 'train' / 'weights' / 'best.pt'\n",
        "DETECTION_LAST = OUT / 'detection' / 'train' / 'weights' / 'last.pt'\n",
        "assert DETECTION_BEST.exists(), DETECTION_BEST\n",
        "print('Detection best:', DETECTION_BEST)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 6. YOLO26 Segmentation Training"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if RUN_TRAINING:\n",
        "    seg_model = YOLO(SEGMENTATION_MODEL)\n",
        "    seg_model.train(data=SEGMENTATION_DATA_YAML, imgsz=IMGSZ, epochs=EPOCHS, seed=SEED, batch=BATCH, patience=PATIENCE, pretrained=True, project=str(OUT/'segmentation'), name='train', exist_ok=True, task='segment')\n",
        "SEGMENTATION_BEST = OUT / 'segmentation' / 'train' / 'weights' / 'best.pt'\n",
        "SEGMENTATION_LAST = OUT / 'segmentation' / 'train' / 'weights' / 'last.pt'\n",
        "assert SEGMENTATION_BEST.exists(), SEGMENTATION_BEST\n",
        "print('Segmentation best:', SEGMENTATION_BEST)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 7. Detection and Segmentation Evaluation"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def metric_rows(metrics, prefix):\n",
        "    rows=[]\n",
        "    if hasattr(metrics, 'box'):\n",
        "        rows += [{'metric':'box_precision','value':float(metrics.box.mp)}, {'metric':'box_recall','value':float(metrics.box.mr)}, {'metric':'box_map50','value':float(metrics.box.map50)}, {'metric':'box_map50_95','value':float(metrics.box.map)}]\n",
        "    if hasattr(metrics, 'seg'):\n",
        "        rows += [{'metric':'mask_precision','value':float(metrics.seg.mp)}, {'metric':'mask_recall','value':float(metrics.seg.mr)}, {'metric':'mask_map50','value':float(metrics.seg.map50)}, {'metric':'mask_map50_95','value':float(metrics.seg.map)}]\n",
        "    return rows\n",
        "det_metrics = YOLO(str(DETECTION_BEST)).val(data=DETECTION_DATA_YAML, imgsz=IMGSZ, conf=CONF_THRESHOLD, split='val', plots=True, task='detect')\n",
        "seg_metrics = YOLO(str(SEGMENTATION_BEST)).val(data=SEGMENTATION_DATA_YAML, imgsz=IMGSZ, conf=CONF_THRESHOLD, split='val', plots=True, task='segment')\n",
        "pd.DataFrame(metric_rows(det_metrics, 'det')).to_csv(OUT/'tables'/'detection_metrics.csv', index=False)\n",
        "pd.DataFrame(metric_rows(seg_metrics, 'seg')).to_csv(OUT/'tables'/'segmentation_metrics.csv', index=False)\n",
        "display(pd.read_csv(OUT/'tables'/'detection_metrics.csv'))\n",
        "display(pd.read_csv(OUT/'tables'/'segmentation_metrics.csv'))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 8. YOLO26-Depth Inference: One Common Depth Map Per Image"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "depth_model = YOLO(DEPTH_MODEL)\n",
        "depth_rows=[]\n",
        "for img in list_images(DETECTION_DATASET_ROOT):\n",
        "    res = depth_model.predict(str(img), imgsz=IMGSZ, verbose=False)[0]\n",
        "    depth = extract_depth_array(res)\n",
        "    npy = OUT/'depth'/f'{image_id(img)}_depth.npy'\n",
        "    png = OUT/'depth'/f'{image_id(img)}_depth.png'\n",
        "    np.save(npy, depth)\n",
        "    plt.figure(figsize=(8,6)); plt.imshow(depth, cmap='magma'); plt.colorbar(label=f'{DEPTH_TYPE} depth ({DEPTH_UNIT})'); plt.axis('off'); plt.tight_layout(); plt.savefig(png, dpi=150); plt.close()\n",
        "    depth_rows.append({'image_id': image_id(img), 'image_path': str(img), 'depth_npy': str(npy), 'depth_png': str(png), 'depth_shape': 'x'.join(map(str, depth.shape)), 'depth_type': DEPTH_TYPE, 'depth_unit': DEPTH_UNIT})\n",
        "pd.DataFrame(depth_rows).to_csv(OUT/'tables'/'depth_manifest.csv', index=False)\n",
        "display(pd.DataFrame(depth_rows).head())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 9. Prediction Tables"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def prediction_table(model_path, dataset_root, data_yaml, task):\n",
        "    names = load_names(data_yaml); model = YOLO(str(model_path)); rows=[]\n",
        "    for img in list_images(dataset_root):\n",
        "        im = Image.open(img).convert('RGB'); w,h = im.size\n",
        "        r = model.predict(str(img), imgsz=IMGSZ, conf=CONF_THRESHOLD, verbose=False, task=task)[0]\n",
        "        if r.boxes is None: continue\n",
        "        xyxy = r.boxes.xyxy.detach().cpu().numpy(); confs = r.boxes.conf.detach().cpu().numpy(); clss = r.boxes.cls.detach().cpu().numpy().astype(int)\n",
        "        polys = r.masks.xyn if task == 'segment' and getattr(r, 'masks', None) is not None else []\n",
        "        for i, box in enumerate(xyxy):\n",
        "            cls=int(clss[i]); row={'image_id':image_id(img),'image_path':str(img),'object_id':f'{task}_{image_id(img)}_{i:04d}','class_id':cls,'class_name':names.get(cls,str(cls)),'confidence':float(confs[i]),'x1':float(box[0]),'y1':float(box[1]),'x2':float(box[2]),'y2':float(box[3]),'image_width':w,'image_height':h}\n",
        "            if len(polys): row['mask_polygon_norm'] = json.dumps(np.asarray(polys[i]).tolist())\n",
        "            rows.append(row)\n",
        "    out = OUT/'tables'/('segmentation_predictions.csv' if task=='segment' else 'detection_predictions.csv')\n",
        "    pd.DataFrame(rows).to_csv(out, index=False); return out\n",
        "DET_PRED = prediction_table(DETECTION_BEST, DETECTION_DATASET_ROOT, DETECTION_DATA_YAML, 'detect')\n",
        "SEG_PRED = prediction_table(SEGMENTATION_BEST, SEGMENTATION_DATASET_ROOT, SEGMENTATION_DATA_YAML, 'segment')\n",
        "print(DET_PRED, SEG_PRED)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 10. BBox and Mask Depth Extraction"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def depth_for(row): return np.load(OUT/'depth'/f'{row.image_id}_depth.npy')\n",
        "def extract_bbox_depth(pred_csv):\n",
        "    rows=[]\n",
        "    for _, row in pd.read_csv(pred_csv).iterrows():\n",
        "        h,w=int(row.image_height),int(row.image_width); depth=resize_depth(depth_for(row),h,w)\n",
        "        x1,y1,x2,y2=[int(round(row[k])) for k in ['x1','y1','x2','y2']]; x1=max(0,x1); y1=max(0,y1); x2=min(w,x2); y2=min(h,y2)\n",
        "        crop=depth[y1:y2,x1:x2]; cx=int(round((x1+x2)/2)); cy=int(round((y1+y2)/2))\n",
        "        sx1=int(round((x1+x2)/2-(x2-x1)*0.3)); sx2=int(round((x1+x2)/2+(x2-x1)*0.3)); sy1=int(round((y1+y2)/2-(y2-y1)*0.3)); sy2=int(round((y1+y2)/2+(y2-y1)*0.3))\n",
        "        full=safe_stats(crop); central=safe_stats(depth[max(0,sy1):min(h,sy2),max(0,sx1):min(w,sx2)])\n",
        "        rows.append({**row.to_dict(),'bbox_center_x':(x1+x2)/2,'bbox_center_y':(y1+y2)/2,'bbox_center_x_norm':((x1+x2)/2)/w,'bbox_center_y_norm':((y1+y2)/2)/h,'depth_bbox_center':float(depth[min(max(cy,0),h-1),min(max(cx,0),w-1)]),'depth_bbox_full_median':full['median'],'depth_bbox_central60_median':central['median'],'depth_bbox_mean':full['mean'],'depth_bbox_std':full['std'],'depth_bbox_min':full['min'],'depth_bbox_max':full['max'],'bbox_valid_depth_ratio':full['valid_ratio'],'bbox_depth_pixel_count':full['pixel_count']})\n",
        "    out=OUT/'tables'/'bbox_depth.csv'; pd.DataFrame(rows).to_csv(out,index=False); return out\n",
        "def poly_mask(poly,w,h):\n",
        "    pts=np.asarray(json.loads(poly),dtype=np.float32); pts[:,0]*=w; pts[:,1]*=h; mask=np.zeros((h,w),dtype=np.uint8); cv2.fillPoly(mask,[pts.astype(np.int32)],1); return mask.astype(bool)\n",
        "def extract_mask_depth(pred_csv):\n",
        "    rows=[]; kernel=np.ones((EROSION_KERNEL,EROSION_KERNEL),np.uint8)\n",
        "    for _, row in pd.read_csv(pred_csv).iterrows():\n",
        "        if not isinstance(row.get('mask_polygon_norm'), str): continue\n",
        "        h,w=int(row.image_height),int(row.image_width); depth=resize_depth(depth_for(row),h,w); mask=poly_mask(row.mask_polygon_norm,w,h); er=cv2.erode(mask.astype(np.uint8),kernel,iterations=1).astype(bool); ys,xs=np.where(mask)\n",
        "        cenx=float(np.mean(xs)) if xs.size else np.nan; ceny=float(np.mean(ys)) if ys.size else np.nan; base=safe_stats(depth[mask]); erstats=safe_stats(depth[er])\n",
        "        rows.append({**row.to_dict(),'mask_centroid_x':cenx,'mask_centroid_y':ceny,'mask_centroid_x_norm':cenx/w,'mask_centroid_y_norm':ceny/h,'mask_area_pixels':int(mask.sum()),'depth_mask_median':base['median'],'depth_mask_mean':base['mean'],'depth_mask_std':base['std'],'depth_mask_min':base['min'],'depth_mask_max':base['max'],'mask_valid_depth_ratio':base['valid_ratio'],'mask_depth_pixel_count':base['pixel_count'],'depth_mask_eroded_median':erstats['median']})\n",
        "    out=OUT/'tables'/'mask_depth.csv'; pd.DataFrame(rows).to_csv(out,index=False); return out\n",
        "BBOX_DEPTH=extract_bbox_depth(DET_PRED); MASK_DEPTH=extract_mask_depth(SEG_PRED)\n",
        "display(pd.read_csv(BBOX_DEPTH).head()); display(pd.read_csv(MASK_DEPTH).head())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 11. Object-Instance Matching and Depth Comparison"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "bbox=pd.read_csv(BBOX_DEPTH); mask=pd.read_csv(MASK_DEPTH); matches=[]; used=set()\n",
        "for _, b in bbox.iterrows():\n",
        "    cand=mask[(mask.image_id==b.image_id)&(mask.class_id==b.class_id)]\n",
        "    best=None; best_iou=-1\n",
        "    for _, m in cand.iterrows():\n",
        "        if m.object_id in used: continue\n",
        "        iou=box_iou((b.x1,b.y1,b.x2,b.y2),(m.x1,m.y1,m.x2,m.y2))\n",
        "        if iou>best_iou: best=m; best_iou=iou\n",
        "    if best is not None and best_iou>=MATCH_IOU_THRESHOLD:\n",
        "        used.add(best.object_id); matches.append({'image_id':b.image_id,'bbox_object_id':b.object_id,'mask_object_id':best.object_id,'class_name':b.class_name,'bbox_confidence':b.confidence,'mask_confidence':best.confidence,'bbox_mask_iou':best_iou,'match_status':'matched'})\n",
        "    else:\n",
        "        matches.append({'image_id':b.image_id,'bbox_object_id':b.object_id,'mask_object_id':'','class_name':b.class_name,'bbox_confidence':b.confidence,'mask_confidence':np.nan,'bbox_mask_iou':np.nan,'match_status':'unmatched_detection'})\n",
        "MATCHES=OUT/'tables'/'instance_matches.csv'; pd.DataFrame(matches).to_csv(MATCHES,index=False)\n",
        "bidx=bbox.set_index('object_id'); midx=mask.set_index('object_id'); rows=[]\n",
